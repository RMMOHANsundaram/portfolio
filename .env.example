# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Optional: if not set, server gracefully uses in-memory storage fallback
MONGODB_URI=mongodb://127.0.0.1:27017/mohan_portfolio

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Email Service Credentials (for automated forwarding of contact messages)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL=r.m.mohansundaram@gmail.com
